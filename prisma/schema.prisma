generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  phone    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("user")
}
